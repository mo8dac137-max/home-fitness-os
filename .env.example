# Supabase (Phase 4A). Copy this file to `.env` and fill in real values.
# `.env` is gitignored — NEVER commit real keys to this repository.
#
# VITE_SUPABASE_URL: project URL, e.g. https://<project-ref>.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY: the PUBLIC publishable key (safe for client
#   bundles, RLS-protected). NEVER put the secret/service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
